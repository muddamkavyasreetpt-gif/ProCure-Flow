# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
LLM_MODE=mock
LLM_FALLBACK=true
LLM_RPM=8
RUN_TIMEOUT_MS=240000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
JWT_SECRET=your_jwt_secret_min_32_chars_random_string_here
JWT_EXPIRES_IN=8h
# Required ONLY for `npm run migrate`: Supabase Dashboard -> Connect -> Session pooler connection string (use the pooler string, the direct string is IPv6-only on the free tier).
SUPABASE_DB_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-eu-north-1.pooler.supabase.com:5432/postgres
