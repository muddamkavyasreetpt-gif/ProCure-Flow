{
  "name": "procureflow",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "typecheck": "npm --prefix server run typecheck && npm --prefix client run typecheck",
    "check:secrets": "npm --prefix server run check:secrets",
    "test": "npm --prefix server test",
    "test:scenarios": "npm --prefix server run test:scenarios",
    "seed:users": "npm --prefix server run seed:users",
    "seed:reset-demo": "npm --prefix server run seed:reset-demo",
    "migrate": "npm --prefix server run migrate"
  }
}
